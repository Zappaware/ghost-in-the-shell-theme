# Ghost in the Shell — btop

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""
theme_background=false

# Main text color
theme[main_fg]="#bcd4d0"

# Title color for boxes
theme[title]="#cfe6e1"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#31d6b6"

# Background color of selected item in processes box
theme[selected_bg]="#1b3b3d"

# Foreground color of selected item in processes box
theme[selected_fg]="#e9fffb"

# Color of inactive/disabled text
theme[inactive_fg]="#2e4d50"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#5cf0d4"

# Cpu box outline color
theme[cpu_box]="#2e4d50"

# Memory/disks box outline color
theme[mem_box]="#2e4d50"

# Net up/down box outline color
theme[net_box]="#2e4d50"

# Processes box outline color
theme[proc_box]="#2e4d50"

# Box divider line and small boxes line color
theme[div_line]="#1b3b3d"

# Temperature graph colors
theme[temp_start]="#31d6b6"
theme[temp_mid]="#d9a441"
theme[temp_end]="#e0574f"

# CPU graph colors
theme[cpu_start]="#5b7d7c"
theme[cpu_mid]="#31d6b6"
theme[cpu_end]="#5cf0d4"

# Mem/Disk free meter
theme[free_start]="#2e4d50"
theme[free_mid]="#4f9fc2"
theme[free_end]="#6fbfe0"

# Mem/Disk cached meter
theme[cached_start]="#4f9fc2"
theme[cached_mid]="#31d6b6"
theme[cached_end]="#5cf0d4"

# Mem/Disk available meter
theme[available_start]="#6b5238"
theme[available_mid]="#d9a441"
theme[available_end]="#f2bd55"

# Mem/Disk used meter
theme[used_start]="#a878c9"
theme[used_mid]="#e07b39"
theme[used_end]="#ff6f63"

# Download graph colors
theme[download_start]="#2e4d50"
theme[download_mid]="#31d6b6"
theme[download_end]="#5cf0d4"

# Upload graph colors
theme[upload_start]="#6b5238"
theme[upload_mid]="#e07b39"
theme[upload_end]="#f2bd55"
